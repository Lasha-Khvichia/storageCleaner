{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storageCleaner",
  "version": "0.2.0",
  "identifier": "com.lashakhvichia.storagecleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "storageCleaner",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lasha Khvichia",
    "copyright": "© 2026 Lasha Khvichia",
    "category": "Utility",
    "shortDescription": "Disk analyzer & cleaner",
    "longDescription": "Scan whole drives, see exactly what uses your space, and clean it up safely with Recycle Bin deletes, safety ratings and recommended cleanups.",
    "homepage": "https://github.com/Lasha-Khvichia/storageCleaner",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
